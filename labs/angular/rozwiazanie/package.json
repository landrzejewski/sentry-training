{
  "name": "shop-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "sourcemaps:inject": "npx @sentry/cli sourcemaps inject dist/shop-web/browser",
    "sourcemaps:upload": "npx @sentry/cli sourcemaps upload --project sentry-training --release shop-web@1.0.0 dist/shop-web/browser",
    "serve:dist": "npx --yes http-server@14.1.1 dist/shop-web/browser -a localhost -p 4300 -c-1"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@sentry/angular": "11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@sentry/cli": "3.8.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
